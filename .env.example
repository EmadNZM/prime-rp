# =================================================================
# PRIME RP - Production Environment Variables
# =================================================================

# Server & Runtime Configuration
NODE_ENV=production
SESSION_SECRET=your_super_secret_session_key_minimum_32_characters

# Database (PostgreSQL required in production)
DATABASE_URL=postgresql://user:password@host:5432/prime_rp?sslmode=require

# Discord OAuth2 & Bot Integration
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DISCORD_REDIRECT_URI=https://yourdomain.com/api/auth/discord/callback
DISCORD_BOT_TOKEN=your_discord_bot_token_for_notifications_and_roles
DISCORD_GUILD_ID=your_primary_discord_server_guild_id

# Security & Ownership (CRITICAL: Must match your real Discord Snowflake ID)
OWNER_DISCORD_ID=your_discord_user_snowflake_id

# FiveM FXServer Live Integration
FIVEM_SERVER_IP=127.0.0.1
FIVEM_SERVER_PORT=30120

# Optional Payment Gateways (Leave empty if handling transactions manually)
STRIPE_SECRET_KEY=
TEBEX_SECRET=

# AI & Additional Features
GEMINI_API_KEY=
